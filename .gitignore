# Python缓存文件
__pycache__/
*.pyc
*.pyo
*.pyd

# 虚拟环境（绝不提交/推送）
.venv/
venv/

# 密钥、环境变量【最重要】
.env
.env.*

# VSCode本地配置
.vscode/

# 系统垃圾文件
.DS_Store

# 日志文件
*.log
logs/

# Streamlit缓存
.streamlit/cache/

# AI 工具本地状态（不属于项目代码，部署镜像/仓库不包含）
.agents/
.claude/
skills-lock.json
.playwright-mcp/
.sisyphus/

# Node 依赖目录
node_modules/

# Local SQLite data
*.db
*.db-*
*.sqlite
*.sqlite-*

